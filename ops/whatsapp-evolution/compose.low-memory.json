{
  "services": {
    "postgres": {
      "mem_limit": "384m"
    },
    "redis": {
      "mem_limit": "128m",
      "command": ["redis-server", "--appendonly", "yes", "--appendfsync", "everysec", "--maxmemory", "64mb", "--maxmemory-policy", "noeviction"]
    },
    "evolution": {
      "mem_limit": "1g",
      "environment": {
        "NODE_OPTIONS": "--max-old-space-size=768"
      }
    }
  }
}
