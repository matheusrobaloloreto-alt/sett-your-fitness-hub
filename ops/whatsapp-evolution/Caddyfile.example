# Host-installed Caddy only. Root must replace this reserved placeholder.
# Containerized Caddy cannot use this loopback upstream unchanged.
https://REPLACE_WITH_APPROVED_EVOLUTION_HOST {
    @management path /manager /manager/* /docs /docs/* /assets/* /metrics /verify-creds
    respond @management 404
    reverse_proxy 127.0.0.1:8080 {
        # Server-to-server gate: fixed Origin for Evolution v2.3.7, not browser CORS access.
        # Keep API-key authentication; never reflect the client's Origin or use a wildcard.
        header_up Origin https://invalid.invalid
    }
    # Deliberately no access log: instance URLs may contain sensitive data.
}
